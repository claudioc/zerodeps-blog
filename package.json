{
  "name": "zerodeps-blog",
  "version": "1.1.0",
  "description": "A zero-dependency static blog starter kit powered by a single Node.js script",
  "type": "module",
  "scripts": {
    "build": "mkdir -p _site && node --permission --allow-fs-read=./ --allow-fs-write=./_site/ build.mjs",
    "serve": "mkdir -p _site && node --permission --allow-fs-read=./ --allow-fs-write=./_site/ build.mjs --serve",
    "start": "npm run serve",
    "eject": "node --permission --allow-fs-read=./ --allow-fs-write=./ eject.mjs",
    "test": "mkdir -p _site && node --permission --allow-fs-read=./ --allow-fs-write=./_site/ test.mjs",
    "build:unsafe": "node build.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": ["static-site-generator", "blog", "starter", "zero-dependencies"],
  "author": "Claudio Cicali <claudio.cicali@gmail.com>",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudioc/zerodeps-blog.git"
  }
}
